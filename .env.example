# =============================================================================
# Panda Project - configuração (copie para .env e preencha)
#   cp .env.example .env
# Linhas com # na frente estão desligadas. Nunca coloque este arquivo no Git.
# Gerar um segredo forte:   openssl rand -hex 32
# =============================================================================

# ---------------------------------------------------------------------------
# 1. ENDEREÇO DO SISTEMA
# ---------------------------------------------------------------------------
# Endereço pelo qual você abre o sistema no navegador, SEM barra no final.
# No seu computador:  http://localhost:5173
# Num servidor:       https://projetos.seudominio.com.br  (ou http://IP:5173)
KANEO_CLIENT_URL=http://localhost:5173
# Só se a API ficar em outro endereço (padrão: KANEO_CLIENT_URL/api). Em geral, deixe desligado.
# KANEO_API_URL=
# Origens extras aceitas pela API, separadas por vírgula (padrão: KANEO_CLIENT_URL).
# CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 2. SEGREDOS (obrigatórios)
# ---------------------------------------------------------------------------
# Assina as sessões de login. Se ficar vazio, um valor aleatório é criado a cada
# reinício e todo mundo é desconectado. Preencha com: openssl rand -hex 32
AUTH_SECRET=
# Criptografa segredos guardados no banco (por exemplo, o segredo do webhook de
# notificações). SEM ISSO, salvar um webhook com segredo dá erro. Se você trocar
# este valor depois, os segredos já salvos deixam de abrir. Guarde uma cópia.
# Preencha com: openssl rand -hex 32
NOTIFICATION_SECRET_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 3. BANCO DE DADOS (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
# Escolha uma senha forte (sem espaços). No Docker Compose o banco é criado com ela.
POSTGRES_PASSWORD=
# Só se for usar um banco de fora do Docker (em vez das linhas acima):
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ---------------------------------------------------------------------------
# 4. ARQUIVOS (comprovantes, notas fiscais e anexos) - armazenamento S3
# ---------------------------------------------------------------------------
# No Docker Compose padrão, o serviço "storage" (SeaweedFS) faz o papel de S3 e já vem configurado; basta
# escolher usuário e senha (a senha precisa de 8 caracteres ou mais).
# S3_ENDPOINT precisa abrir tanto de dentro do Docker quanto do navegador.
#   No Windows/Mac com Docker Desktop: http://host.docker.internal:9000
#   (localhost NAO serve: dentro do container ele aponta para o próprio container)
#   Num servidor:      http://IP-DO-SERVIDOR:9000  (ou o endereço público do S3)
S3_ENDPOINT=http://host.docker.internal:9000
S3_BUCKET=panda-project
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Os arquivos do financeiro são sempre privados; quem baixa passa pela API.
# Tamanho máximo de comprovante/NF/anexo do financeiro, em bytes (padrão 25 MB).
# FINANCE_MAX_FILE_BYTES=26214400
# Outros ajustes do S3 (raramente necessários):
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=
# S3_MAX_IMAGE_UPLOAD_BYTES=
# S3_PRESIGN_TTL_SECONDS=

# ---------------------------------------------------------------------------
# 5. QUEM PODE CRIAR CONTA
# ---------------------------------------------------------------------------
# Fluxo recomendado:
#   1) A PRIMEIRA conta criada vira Administrador (dono). Isso vale mesmo com a
#      linha abaixo ligada.
#   2) Depois disso, ninguém se cadastra sozinho: novas pessoas só entram por
#      convite (link copiável em Configurações > Usuários).
# Por isso o padrão já é "true". Para abrir o cadastro a qualquer pessoa, troque
# para false e reinicie.
DISABLE_REGISTRATION=true
# Outras travas (opcionais):
# DISABLE_WORKSPACE_CREATION=false
# DISABLE_GUEST_ACCESS=false
# DISABLE_PASSWORD_REGISTRATION=false
# DISABLE_LOGIN_FORM=false

# ---------------------------------------------------------------------------
# 6. E-MAIL (opcional). Sem SMTP, convites e avisos por e-mail não são enviados,
#    mas o link do convite pode ser copiado e mandado por WhatsApp.
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Panda Project <nao-responda@seudominio.com.br>"
# SMTP_REQUIRE_TLS=
# Com SMTP, o login usa código por e-mail. Para usar e-mail e senha, ligue:
# DISABLE_EMAIL_OTP_SIGN_IN=true

# ---------------------------------------------------------------------------
# 7. AVISOS PARA WEBHOOK / WHATSAPP (opcional)
# ---------------------------------------------------------------------------
# Por segurança, o webhook só aceita endereços públicos. Se a sua automação (n8n)
# roda na mesma rede/servidor e você precisa apontar para um endereço interno,
# ligue esta linha (veja docs/whatsapp-aviso-reta-final.md).
# KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=true

# ---------------------------------------------------------------------------
# 8. AVANÇADO (pode ignorar)
# ---------------------------------------------------------------------------
# Atrás de proxy reverso (Nginx, Traefik, Cloudflare), informe os IPs do proxy:
# TRUSTED_PROXIES=
# Vários servidores da API ao mesmo tempo (alta disponibilidade): Redis para tempo real.
# REDIS_URL=
# Domínio do cookie de login, se a API e o site ficarem em subdomínios diferentes.
# COOKIE_DOMAIN=
# Chave que criptografa o segredo e o token do Google Drive (Configurações > Google
# Drive). Se ficar vazia, usa a NOTIFICATION_SECRET_ENCRYPTION_KEY. Se trocar depois,
# será preciso reconectar o Google Drive.
# APP_SECRETS_KEY=
# Erros para o Sentry (desligado por padrão):
# SENTRY_DSN=

# Login com Google/GitHub/Discord ou OAuth próprio: deixe em branco para manter
# desligado. As variáveis existem (GOOGLE_CLIENT_ID/SECRET, GITHUB_OAUTH_*,
# DISCORD_CLIENT_ID/SECRET, CUSTOM_OAUTH_*) mas o Panda Project não as usa por padrão.
